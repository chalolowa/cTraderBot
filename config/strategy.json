{
  "name": "DayTrader_SMA_RSI_V5_ProfitProtect",
  "description": "M15 crossover or pullback-continuation entries gated by the H1 trend; correlation limits; profit-protection management (breakeven, give-back stop, ATR trail, reversal exits, dynamic take-profit) enforced by the bot as well as the broker. Validate in demo before live use.",
  "timeframe": "M15",
  "candle_count": 200,
  "entry_rules": {
    "long": {
      "conditions": [
        {
          "indicator": "SMA",
          "period": 9,
          "comparison": "crosses_above",
          "reference": "SMA",
          "ref_period": 21
        },
        {
          "indicator": "RSI",
          "period": 14,
          "comparison": ">",
          "value": 50
        },
        {
          "indicator": "RSI",
          "period": 14,
          "comparison": "<",
          "value": 80
        },
        {
          "indicator": "ADX",
          "period": 14,
          "comparison": ">",
          "value": 20
        }
      ],
      "require_all": true
    },
    "short": {
      "conditions": [
        {
          "indicator": "SMA",
          "period": 9,
          "comparison": "crosses_below",
          "reference": "SMA",
          "ref_period": 21
        },
        {
          "indicator": "RSI",
          "period": 14,
          "comparison": "<",
          "value": 50
        },
        {
          "indicator": "RSI",
          "period": 14,
          "comparison": ">",
          "value": 20
        },
        {
          "indicator": "ADX",
          "period": 14,
          "comparison": ">",
          "value": 20
        }
      ],
      "require_all": true
    }
  },
  "exit_rules": {
    "stop_loss": {
      "type": "ATR_MULTIPLE",
      "atr_period": 14,
      "atr_multiplier": 2.0
    },
    "take_profit": {
      "type": "RISK_REWARD",
      "risk_reward_ratio": 2.5
    },
    "time_exit": {
      "close_before_market_close": true,
      "buffer_minutes": 30
    },
    "trailing_stop": {
      "enabled": true,
      "activation_r_multiple": 1.5,
      "trail_atr_multiplier": 1.5
    }
  },
  "trade_management": {
    "enabled": true,
    "breakeven_r": 1.0,
    "breakeven_buffer_r": 0.1,
    "min_stop_step_r": 0.1,
    "min_stop_distance_pips": 1.0,
    "exit_on_opposite_cross_in_profit": true,
    "min_profit_r_for_signal_exit": 0.2,
    "exit_on_htf_flip": true,
    "late_day_lock_minutes": 120,
    "late_day_lock_min_r": 0.3,
    "late_day_lock_fraction": 0.5,
    "late_day_close_minutes": 45,
    "late_day_close_min_r": 0.5,
    "management_interval_seconds": 10,
    "software_stops": true,
    "giveback_enabled": true,
    "giveback_arm_r": 0.8,
    "giveback_fraction": 0.5,
    "reversal_exit_enabled": true,
    "reversal_min_profit_r": 0.3,
    "reversal_votes_required": 2,
    "reversal_body_atr": 1.0,
    "tp_adjust_enabled": true,
    "tp_adjust_min_peak_r": 1.0,
    "tp_fade_bars": 3,
    "tp_near_atr": 1.0
  },
  "risk_management": {
    "risk_per_trade_pct": 1.0,
    "max_daily_loss_pct": 2.0,
    "max_open_trades": 5,
    "min_risk_reward": 1.5
  },
  "entry_guards": {
    "max_signal_age_minutes": 5,
    "max_chase_atr": 0.5,
    "cooldown_minutes_after_loss": 90,
    "max_trades_per_symbol_per_day": 2,
    "max_consecutive_losses": 3,
    "max_currency_net_exposure": 3,
    "no_new_entries_minutes_before_flatten": 90,
    "correlation_guard": {
      "enabled": true,
      "timeframe": "M15",
      "lookback_bars": 200,
      "min_overlap_bars": 60,
      "max_effective_corr": 0.65,
      "cache_minutes": 15,
      "max_correlated_positions": 3,
      "exclude_risk_free": true
    }
  },
  "filters": {
    "spread_max_pips": 3.0,
    "avoid_news_events": false,
    "trend_alignment_timeframe": "H1",
    "trend_filter": {
      "enabled": true,
      "timeframe": "H1",
      "candle_count": 150,
      "ema_fast": 20,
      "ema_slow": 50,
      "slope_bars": 5,
      "adx_period": 14,
      "min_adx": 20,
      "drift_lookback_bars": 12,
      "max_counter_drift_atr": 1.0
    }
  },
  "instruments": [
    "EURUSD",
    "GBPUSD",
    "USDJPY",
    "AUDUSD",
    "USDCAD",
    "EURGBP",
    "EURJPY",
    "GBPJPY",
    "AUDJPY"
  ],
  "entry_modes": {
    "pullback": {
      "enabled": true,
      "lookback_bars": 3,
      "tolerance_atr": 0.25,
      "min_adx": 20,
      "rsi_min": 45,
      "rsi_max": 85,
      "min_gap_bars": 4
    }
  }
}